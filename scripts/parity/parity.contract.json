{
  "version": 1,
  "comment": "Paired DocxEditorProps / DocxEditorRef members across the React and Vue adapters.",
  "props": {
    "paired": [
      "author",
      "chrome",
      "colorMode",
      "contextMenu",
      "document",
      "fonts",
      "hyperlinkPopup",
      "i18n",
      "locale",
      "menu",
      "mode",
      "modules",
      "navigation",
      "rulers",
      "t",
      "title",
      "zoom",
      "zoomMode"
    ],
    "deferredInVue": {},
    "reactCallbacksAsVueEmits": {
      "onChange": "change",
      "onReady": "ready",
      "onFontError": "fontError",
      "onSave": "save",
      "onOpen": "open",
      "onTitleChange": "titleChange"
    },
    "reactRenderPropsAsVueSlots": {
      "children": "default",
      "renderTitleBarLeft": "titleBarLeft",
      "renderTitleBarRight": "titleBarRight"
    },
    "reactClassNameAsVueClass": {
      "className": "class"
    },
    "vueExclusive": {
      "class": "Vue sugar host declares `class` on DocxEditorProps; React names the same surface `className`."
    }
  },
  "composableParity": {
    "comment": "One audited framework slot-form alias pair (OpenSpec slot category). Not a general allowlist.",
    "frameworkSlotFormTypeAliases": {
      "DocxEditorChildren": {
        "react": "ReactNode",
        "vue": "VNode"
      }
    }
  },
  "ref": {
    "comment": "Greenfield DocxEditorRef is the SAME interface on both adapters.",
    "paired": ["exec", "focus", "getDocumentHandle", "getEditor", "load", "save", "snapshot"],
    "pairedViaInheritance": {},
    "vueExclusive": {}
  },
  "pro": {
    "comment": "Pro review surface across docs/api/docx-editor-pro/{react,vue}.api.md: top-level exports, DocxEditorReview compound part names, and extends-resolved member names of the pinned memberCheckedInterfaces list. webrtcExports covers the separate {react,vue}-webrtc.api.md pair, which the review entries do not include.",
    "webrtcExports": {
      "paired": [
        "CollaborationSession",
        "UseWebrtcCollaborationBootstrap",
        "UseWebrtcCollaborationConnectOptions",
        "UseWebrtcCollaborationOptions",
        "UseWebrtcCollaborationReturn",
        "useWebrtcCollaboration"
      ],
      "deferredInVue": {},
      "vueExclusive": {}
    },
    "exports": {
      "paired": [
        "CustomNodeChrome",
        "CustomNodeChromeProps",
        "CustomNodeContextMenu",
        "CustomNodeContextMenuProps",
        "DocxEditorReview",
        "DocxEditorReviewNamespace",
        "ProLicenseOptions",
        "ResolvedCustomNodeActivation",
        "ReviewActionProps",
        "ReviewActivationOptions",
        "ReviewItemView",
        "ReviewMarkersProps",
        "ReviewModuleOptions",
        "ReviewPartProps",
        "ReviewProps",
        "UseReviewReturn",
        "activatedCustomNodeOf",
        "resolveCustomNodeActivation",
        "reviewModule",
        "useCustomNodeDefinitions",
        "useReview",
        "useReviewAuthor",
        "useReviewItem",
        "useReviewOf",
        "useStackedReviewPositions",
        "collaborationModule",
        "CollaborationModuleOptions",
        "useCollaborationStatus",
        "UseCollaborationStatusReturn"
      ],
      "deferredInVue": {},
      "vueExclusive": {}
    },
    "reviewParts": {
      "paired": [
        "Accept",
        "AddComment",
        "Author",
        "Avatar",
        "Balloon",
        "Card",
        "Delete",
        "Draft",
        "Empty",
        "List",
        "Markers",
        "Reject",
        "Reopen",
        "Replies",
        "Reply",
        "Resolve",
        "Summary",
        "Time"
      ],
      "deferredInVue": {},
      "vueExclusive": {}
    },
    "memberCheckedInterfaces": [
      "CustomNodeChromeProps",
      "CustomNodeContextMenuProps",
      "ProLicenseOptions",
      "ResolvedCustomNodeActivation",
      "ReviewActionProps",
      "ReviewActivationOptions",
      "ReviewMarkersProps",
      "ReviewModuleOptions",
      "ReviewPartProps",
      "ReviewProps",
      "UseReviewReturn",
      "CollaborationModuleOptions",
      "UseCollaborationStatusReturn"
    ],
    "interfaceMemberExceptions": {
      "ReviewMarkersProps": {
        "vueOnly": ["asChild", "children"],
        "reason": "Vue declares ReviewMarkersProps as extending ReviewPartProps, so asChild and children appear in the type although the markers part does not wire them. React declares only the wired members."
      }
    }
  }
}
