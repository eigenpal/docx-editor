    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "test": "bun test"
  },
  "peerDependencies": {
    "@docx-editor.dev/core": "~2.37.0",
    "@docx-editor.dev/react": "~2.37.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "workspace:*",
    "@docx-editor.dev/react": "workspace:*",
    "@types/react": "^19.2.18",
    "react": "^19.0.0",
    "tsup": "^9.0.0"
  }
}
