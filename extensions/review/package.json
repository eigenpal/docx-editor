{
  "name": "@gw/docx-review",
  "version": "0.1.0",
  "description": "Comments and tracked-changes review panel for the docx-editor engine, built only on its Apache-2.0 packages.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
