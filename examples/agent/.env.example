# Copy to .env.local. The key is only ever read in the route handler, never
# shipped to the browser.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Comma-separated origins the chat route will answer. Unset means any
# origin, which is fine on localhost and not fine on a deployment.
ALLOWED_ORIGINS=http://localhost:3003
