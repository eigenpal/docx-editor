            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Presses by delay band",
      "description": "Share of presses in each delay band. Growth in the upper bands means editing got slower.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.016\"}[$__rate_interval]))",
          "legendFormat": "up to 16 ms",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.033\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.016\"}[$__rate_interval]))",
          "legendFormat": "16 to 33 ms",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.05\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.033\"}[$__rate_interval]))",
          "legendFormat": "33 to 50 ms",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.1\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.05\"}[$__rate_interval]))",
          "legendFormat": "50 to 100 ms",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.2\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.1\"}[$__rate_interval]))",
          "legendFormat": "100 to 200 ms",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.5\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.2\"}[$__rate_interval]))",
          "legendFormat": "200 to 500 ms",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"1\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"0.5\"}[$__rate_interval]))",
          "legendFormat": "500 ms to 1 s",
          "refId": "G"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"+Inf\"}[$__rate_interval])) - sum(rate(docx_editor_editor_interaction_duration_seconds_bucket{job=~\"$job\",le=\"1\"}[$__rate_interval]))",
          "legendFormat": "over 1 s",
          "refId": "H"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 60,
            "spanNulls": true,
            "stacking": {
