    {
      "type": "timeseries",
      "title": "Engine work per edit (95th percentile)",
      "description": "Layout and paint after edits and view changes. If typing is slow but these are fast, the delay is in the host app. Values interpolate inside the bands of 16, 33, 50, 100, 200, 500, and 1000 ms, so a flat line near 15 ms means most work fits under 16 ms.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(docx_editor_editor_layout_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "layout",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(docx_editor_editor_paint_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "paint",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
