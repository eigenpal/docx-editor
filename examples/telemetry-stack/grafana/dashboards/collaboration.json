    },
    {
      "type": "timeseries",
      "title": "Update traffic",
      "description": "Bytes of document updates the server applied, per second.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(docx_editor_collab_update_bytes_total[$__rate_interval]))",
          "legendFormat": "bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "stacking": {
              "mode": "none"
