        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\",service=\"docx-editor\",slo=\"\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "service": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No alerts firing"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertname"
