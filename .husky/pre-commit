#!/bin/sh

# Keep every whole-repository gate. Local caches avoid rechecking unchanged files;
# the package scripts and CI still run without these cache flags.
run_check() {
  check_label="$1"
  shift
  check_started=$(date +%s)
  printf '\nRunning %s...\n' "$check_label"
  if "$@"; then
    printf 'Passed %s (%ss)\n' "$check_label" "$(($(date +%s) - check_started))"
  else
    check_status=$?
    printf 'Failed %s (%ss, exit %s)\n' "$check_label" "$(($(date +%s) - check_started))" "$check_status" >&2
    exit "$check_status"
  fi
}

# Fix staged formatting first, then validate the resulting source with every gate.
run_check 'staged formatting and lint' npx lint-staged

# The collaboration policy CI job needs a decision record for any change under the covered
# implementation paths. The check reads the working tree and untracked files too, so it sees
# what this commit adds. It compares against the merge base with main; a checkout without a
# main ref (a shallow clone, a fork) skips it and leaves CI to enforce it.
collaboration_base=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null)
if [ -n "$collaboration_base" ]; then
  run_check 'collaboration policy' node scripts/collaboration/cli.mjs check --base "$collaboration_base"
else
  printf '\nSkipping collaboration policy (no main ref to compare against).\n'
fi

# Each workspace gets compiler-managed build info under its own node_modules.
# TypeScript tracks imported files and compiler options, not just the staged paths.
run_check 'TypeScript type check' bun run typecheck --incremental --tsBuildInfoFile node_modules/.cache/precommit/typecheck.tsbuildinfo
run_check 'parity gates' bun run check:parity
run_check 'license header checks' bun run check:license-headers
run_check 'API snapshot check' bun run api:check

# Content hashes survive branch switches and catch edits even when mtimes match.
# These still walk the entire source tree, including unstaged files. The lint
# script also runs the whole-file max-lines guard on every invocation.
run_check 'formatting check' bun run format:check --cache --cache-strategy content --cache-location node_modules/.cache/precommit/prettier
run_check 'lint' bun run lint --cache --cache-strategy content --cache-location node_modules/.cache/precommit/eslint
