{
  "name": "docx-editor-monorepo",
  "version": "0.0.21",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/free-review",
    "extensions/review",
    "python/docx-to-markdown"
  ],
  "type": "module",
  "scripts": {
    "api:check": "node scripts/api-extractor.mjs",
    "api:extract": "node scripts/api-extractor.mjs --local",
    "bench:edit": "bun scripts/bench/edit-bench.ts",
    "bench:huge": "bun scripts/bench/settle-bench.ts",
    "bench:huge:browser": "bun scripts/bench/typing-url-audit.mjs",
    "bench:scope-waste": "bun scripts/bench/scope-waste-bench.ts",
    "memory:edits": "node scripts/memory/edit-memory.mjs",
    "changeset": "changeset",
    "check:adapter-css-thin": "node scripts/check-adapter-css-thin.mjs",
    "check:example-readmes": "node scripts/check-example-readmes.mjs",
    "check:demo-deployment": "node scripts/check-demo-deployment.mjs",
    "check:editor-contract": "node scripts/check-editor-contract.mjs",
    "check:font-width-fidelity": "bun packages/fonts/scripts/check-width-fidelity.ts",
    "check:i18n-bundle-size": "node scripts/check-i18n-bundle-size.mjs",
    "check:lane-boundaries": "node scripts/check-lane-boundaries.mjs",
    "check:core-css-compiled": "node scripts/check-core-css-compiled.mjs",
    "check:package-artifacts": "node scripts/check-package-artifacts.mjs && node scripts/check-core-css-compiled.mjs",
    "check:package-size": "node scripts/check-package-size.mjs",
    "check:shipped-shaper": "node scripts/check-shipped-shaper.mjs",
    "check:nuxt-auto-imports": "node scripts/check-nuxt-auto-imports.mjs",
    "generate:nuxt-auto-imports": "node scripts/check-nuxt-auto-imports.mjs --write",
    "check:shipped-advisories": "node scripts/check-shipped-advisories.mjs",
    "check:tsconfig-lib-floor": "node scripts/check-tsconfig-lib-floor.mjs",
    "docs:json": "node scripts/build-docs-json.mjs",
    "i18n:codegen": "node scripts/validate-i18n.mjs codegen",
    "i18n:fix": "node scripts/validate-i18n.mjs validate --fix",
    "i18n:new": "node scripts/validate-i18n.mjs new",
    "i18n:status": "node scripts/validate-i18n.mjs status",
    "i18n:validate": "node scripts/validate-i18n.mjs validate && node scripts/check-i18n-unused.mjs",
    "i18n:unused": "node scripts/check-i18n-unused.mjs --list",
    "notices:check": "bun scripts/generate-third-party-notices.mjs --check",
    "notices:generate": "bun scripts/generate-third-party-notices.mjs",
    "prepare": "husky && bun run --filter '@docx-editor.dev/i18n' build",
    "reference:fetch": "node scripts/fetch-reference.mjs",
    "test": "node scripts/test/run-parallel.mjs",
    "test:serial": "bun test",
    "test:changed": "node scripts/test/changed.mjs",
    "test:watch": "bun test --watch",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:root": "bun check -p tsconfig.json",
    "check:lockfile-workspaces": "node scripts/check-lockfile-workspaces.mjs",
    "build": "bun run --filter @docx-editor.dev/i18n build && bun run --filter @docx-editor.dev/core build && bun run --filter @docx-editor.dev/fonts build && bun run --filter @docx-editor.dev/react build && bun run --filter @gw/docx-review build",
    "check:fonts-manifest": "cd packages/fonts && node scripts/generate-manifest.mjs --check",
    "check:google-catalog": "cd packages/fonts && node scripts/generate-google-catalog.mjs --check",
    "lint": "oxlint --report-unused-disable-directives-severity=warn packages/*/src/ packages/docx-to-markdown/test/ examples/*/src/ extensions/review/src/",
    "lint:fix": "oxlint --report-unused-disable-directives-severity=warn --fix packages/*/src/ packages/docx-to-markdown/test/ examples/*/src/ extensions/review/src/",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"examples/*/src/**/*.{ts,tsx,css}\" \"extensions/review/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"examples/*/src/**/*.{ts,tsx,css}\" \"extensions/review/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-release-plan": "5.0.2",
    "@happy-dom/global-registrator": "^21.0.4",
    "@microsoft/api-extractor": "^7.60.0",
    "@microsoft/tsdoc": "^0.17.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.0",
    "cssnano": "^9.9.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "lint-staged": "^17.6.0",
    "memlab": "2.0.6",
    "oxlint": "1.91.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.67.5",
    "rollup-plugin-dts": "^6.5.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.6",
    "vue": "^3.5.44"
  },
  "keywords": [
    "docx",
    "editor",
    "template",
    "word",
    "document",
    "react",
    "prosemirror"
  ],
  "author": "Eigenpal, Inc.",
  "license": "Apache-2.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vite": {
      "postcss": "8.5.32"
    },
    "prosemirror-view": "1.42.3",
    "prosemirror-state": "1.4.4",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "@happy-dom/global-registrator": "21.0.4",
    "happy-dom": "21.0.4",
    "vue": "3.5.44"
  },
  "resolutions": {
    "prosemirror-view": "1.42.3",
    "prosemirror-state": "1.4.4",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "@happy-dom/global-registrator": "21.0.4",
    "happy-dom": "21.0.4",
    "vue": "3.5.44"
  },
  "dependencies": {
    "@docx-editor.dev/core": "workspace:*",
    "@docx-editor.dev/fonts-cjk": "workspace:*",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3"
  }
}
