{
  "name": "docx-editor-monorepo",
  "version": "0.0.21",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/agent",
    "examples/write-agent",
    "examples/astro",
    "examples/automation",
    "examples/custom-nodes",
    "examples/collaboration",
    "examples/collaboration-hocuspocus",
    "examples/happy-path",
    "examples/igloo",
    "examples/nextjs",
    "examples/nuxt",
    "examples/remix",
    "examples/vite",
    "examples/vue"
  ],
  "type": "module",
  "scripts": {
    "api:check": "node scripts/api-extractor.mjs",
    "api:extract": "node scripts/api-extractor.mjs --local",
    "build": "bun run build:packages:demo && bun run build:react && bun run build:vue && bun run build:assemble",
    "build:assemble": "rm -rf examples/parity/dist && mkdir -p examples/parity/dist && cp -R examples/vite/dist examples/parity/dist/react && cp -R examples/vue/dist examples/parity/dist/vue && cp examples/parity/index.html examples/parity/dist/index.html",
    "build:packages": "bun run --filter '@docx-editor.dev/i18n' build && bun run --filter '@docx-editor.dev/core' build && bun run --filter '@docx-editor.dev/fonts' build && bun run --filter '@docx-editor.dev/react' build && bun run --filter '@docx-editor.dev/vue' build && bun run --filter '@docx-editor.dev/editor-api' build && bun run --filter '@docx-editor.dev/pro' build",
    "build:packages:vue": "bun run build:packages && bun run --filter '@docx-editor.dev/vue' build && bun run --filter '@docx-editor.dev/nuxt' build",
    "build:packages:demo": "bun run --filter '@docx-editor.dev/i18n' build && bun run --filter '@docx-editor.dev/core' build && bun run --filter '@docx-editor.dev/fonts' build && bun run --filter '@docx-editor.dev/react' build && bun run --filter '@docx-editor.dev/vue' build && bun run --filter '@docx-editor.dev/pro' build",
    "build:react": "cd examples/vite && USE_PUBLISHED_PACKAGES=true ENABLE_FRAMEWORK_SWITCHER=true VITE_ENABLE_FRAMEWORK_SWITCHER=true VITE_BASE_PATH=/react/ vite build",
    "check:app-build": "cd examples/vite && vite build --logLevel warn --outDir dist-check --emptyOutDir",
    "build:vue": "cd examples/vue && USE_PUBLISHED_PACKAGES=true ENABLE_FRAMEWORK_SWITCHER=true VITE_ENABLE_FRAMEWORK_SWITCHER=true VITE_BASE_PATH=/vue/ vite build",
    "build:preview": "bun run build:packages:demo && bun run build:react:source && bun run build:vue:source && bun run build:assemble",
    "build:react:source": "cd examples/vite && ENABLE_FRAMEWORK_SWITCHER=true VITE_ENABLE_FRAMEWORK_SWITCHER=true VITE_BASE_PATH=/react/ vite build",
    "build:vue:source": "cd examples/vue && ENABLE_FRAMEWORK_SWITCHER=true VITE_ENABLE_FRAMEWORK_SWITCHER=true VITE_BASE_PATH=/vue/ vite build",
    "bench:edit": "bun scripts/bench/edit-bench.ts",
    "bench:edit:browser": "playwright test --config e2e/edit-browser-bench.config.ts",
    "bench:huge": "bun scripts/bench/settle-bench.ts",
    "bench:huge:browser": "bun scripts/bench/typing-url-audit.mjs",
    "bench:scope-waste": "bun scripts/bench/scope-waste-bench.ts",
    "changeset": "changeset",
    "check:adapter-css-thin": "node scripts/check-adapter-css-thin.mjs",
    "check:pro-license-headers": "bun run --filter '@docx-editor.dev/pro' license:check",
    "fix:pro-license-headers": "bun run --filter '@docx-editor.dev/pro' license:add",
    "check:consumer-install": "node scripts/check-consumer-install.mjs",
    "check:docs-mdx": "node scripts/check-docs-mdx.mjs",
    "check:docs-vue-refs": "node scripts/check-docs-vue-refs.mjs",
    "check:editor-api-license-headers": "bun run --filter '@docx-editor.dev/editor-api' license:check",
    "fix:editor-api-license-headers": "bun run --filter '@docx-editor.dev/editor-api' license:add",
    "check:editor-contract": "node scripts/check-editor-contract.mjs",
    "check:composable-parity": "node scripts/check-composable-parity.mjs",
    "check:export-parity": "node scripts/check-export-parity.mjs",
    "check:feature-parity": "node scripts/check-feature-parity.mjs",
    "check:font-width-fidelity": "bun packages/fonts/scripts/check-width-fidelity.ts",
    "check:fonts-manifest": "cd packages/fonts && node scripts/generate-manifest.mjs --check",
    "check:i18n-bundle-size": "node scripts/check-i18n-bundle-size.mjs",
    "check:lane-boundaries": "node scripts/check-lane-boundaries.mjs",
    "check:core-css-compiled": "node scripts/check-core-css-compiled.mjs",
    "check:package-artifacts": "node scripts/check-package-artifacts.mjs && node scripts/check-core-css-compiled.mjs",
    "check:package-size": "node scripts/check-package-size.mjs",
    "check:shipped-shaper": "node scripts/check-shipped-shaper.mjs",
    "check:adapter-mirror": "node scripts/check-adapter-mirror.mjs",
    "check:nuxt-auto-imports": "node scripts/check-nuxt-auto-imports.mjs",
    "generate:nuxt-auto-imports": "node scripts/check-nuxt-auto-imports.mjs --write",
    "check:parity": "bun run check:export-parity && bun run check:editor-contract && bun run check:public-docs-surface && bun run check:parity-contract && bun run check:composable-parity && bun run check:nuxt-auto-imports && bun run check:adapter-mirror && bun run check:adapter-css-thin",
    "check:license-headers": "bun run check:pro-license-headers && bun run check:editor-api-license-headers",
    "check:parity-contract": "node scripts/check-parity-contract.mjs",
    "check:public-docs-surface": "node scripts/check-public-docs-surface.mjs",
    "check:shipped-advisories": "node scripts/check-shipped-advisories.mjs",
    "check:tsconfig-lib-floor": "node scripts/check-tsconfig-lib-floor.mjs",
    "demo-doc:build": "bun scripts/demo-doc/build.ts",
    "dev": "ENABLE_FRAMEWORK_SWITCHER=true VITE_ENABLE_FRAMEWORK_SWITCHER=true bun run --filter './examples/vite' --filter './examples/vue' dev",
    "dev:agent": "cd examples/agent && npm run dev",
    "dev:write-agent": "bun run --filter './examples/write-agent' dev",
    "dev:astro": "cd examples/astro && npm run dev",
    "dev:custom-nodes": "bun run --filter './examples/custom-nodes' dev",
    "dev:collaboration": "bun run --filter './examples/collaboration' dev",
    "dev:collaboration-hocuspocus": "bun run --filter './examples/collaboration-hocuspocus' dev",
    "dev:collaboration-hocuspocus:server": "bun run --filter './examples/collaboration-hocuspocus' server",
    "dev:demo": "bash examples/dev-all.sh",
    "dev:happypath": "bun run --filter './examples/happy-path' dev",
    "dev:igloo": "bun run --filter './examples/igloo' dev",
    "dev:nextjs": "cd examples/nextjs && npm run dev",
    "dev:nuxt": "bun run --filter './examples/nuxt' dev",
    "dev:react": "bun run --filter './examples/vite' dev",
    "dev:remix": "cd examples/remix && npm run dev",
    "dev:vue": "bun run --filter './examples/vue' dev",
    "docs:json": "node scripts/build-docs-json.mjs",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"examples/*/src/**/*.{ts,tsx,css,vue}\" \"examples/*/app/**/*.{ts,tsx,css,vue}\" \"examples/shared/**/*.{ts,tsx,css,vue}\" \"docs/site/content/**/*.mdx\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\" \"examples/*/src/**/*.{ts,tsx,css,vue}\" \"examples/*/app/**/*.{ts,tsx,css,vue}\" \"examples/shared/**/*.{ts,tsx,css,vue}\" \"docs/site/content/**/*.mdx\"",
    "i18n:codegen": "node scripts/validate-i18n.mjs codegen",
    "i18n:fix": "node scripts/validate-i18n.mjs validate --fix",
    "i18n:new": "node scripts/validate-i18n.mjs new",
    "i18n:status": "node scripts/validate-i18n.mjs status",
    "i18n:validate": "node scripts/validate-i18n.mjs validate && node scripts/check-i18n-unused.mjs",
    "i18n:unused": "node scripts/check-i18n-unused.mjs --list",
    "lint": "node scripts/check-eslint-max-lines-globs.mjs && eslint packages/*/src/ examples/*/src/ examples/*/app/ examples/shared/",
    "lint:fix": "node scripts/check-eslint-max-lines-globs.mjs && eslint packages/*/src/ examples/*/src/ examples/*/app/ examples/shared/ --fix",
    "notices:check": "bun scripts/generate-third-party-notices.mjs --check",
    "notices:generate": "bun scripts/generate-third-party-notices.mjs",
    "parity:prepublish": "node scripts/parity-prepublish.mjs",
    "prepare": "husky && bun run --filter '@docx-editor.dev/i18n' build",
    "preview": "bun run build && bunx serve examples/parity/dist -p 4173",
    "reference:fetch": "node scripts/fetch-reference.mjs",
    "release": "bun run build:packages && bun run notices:generate && changeset publish",
    "test": "node scripts/test/run-parallel.mjs",
    "test:serial": "bun test",
    "test:e2e:collab": "playwright test --config e2e/collaboration.config.ts",
    "test:e2e:collab:full": "playwright test --config e2e/collaboration.config.ts collaboration.fulldocument.spec.ts",
    "test:e2e:collab:load": "playwright test --config e2e/collaboration.documentload.config.ts",
    "test:e2e:collab:perf": "playwright test --config e2e/collaboration.performance.config.ts",
    "test:e2e:editor": "playwright test --config e2e/editor-smoke.config.ts",
    "test:watch": "bun test --watch",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "version-packages": "changeset version && bun run --filter '@docx-editor.dev/editor-api' compat:generate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@happy-dom/global-registrator": "^20.8.3",
    "@microsoft/api-extractor": "^7.50.0",
    "@microsoft/tsdoc": "^0.16.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "^1.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "ajv": "^8.12.0",
    "autoprefixer": "^10.4.17",
    "class-variance-authority": "^0.7.0",
    "cssnano": "^7.1.9",
    "eslint": "^10.0.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jszip": "^3.10.1",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.13",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.10",
    "vue": "^3.5.29",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "docx",
    "editor",
    "template",
    "word",
    "document",
    "react",
    "prosemirror"
  ],
  "author": "EigenPal",
  "license": "Apache-2.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "prosemirror-view": "1.41.8",
    "prosemirror-state": "1.4.4",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "@happy-dom/global-registrator": "20.9.0",
    "happy-dom": "20.9.0",
    "vue": "3.5.33"
  },
  "resolutions": {
    "prosemirror-view": "1.41.8",
    "prosemirror-state": "1.4.4",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "@happy-dom/global-registrator": "20.9.0",
    "happy-dom": "20.9.0",
    "vue": "3.5.33"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3"
  }
}
