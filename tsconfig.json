{
  "compilerOptions": {
    // ES2022 rather than ES2020 because `include` below pulls in `packages/react/src`,
    // which reaches core's ES2022 sources. Same floor as the packages themselves.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/react/src/*"],
      "@docx-editor.dev/react": ["./packages/react/src/index.ts"]
    }
  },
  // `docs/site/data` holds the typed feature matrix that CLAUDE.md makes the single source of
  // feature-support claims. It sat outside every typecheck project, so an invalid `tier` value
  // shipped: a matrix nothing typechecks is documentation with extra syntax.
  "include": [
    "src",
    "packages/react/src",
    "examples/shared",
    "examples/vite",
    "examples/plugins",
    "docs/site/data"
  ],
  "exclude": ["node_modules", "dist", "examples/nextjs", "examples/remix", "examples/astro"]
}
