{
  "name": "@docx-editor.dev/pro",
  "version": "0.0.1",
  "private": true,
  "description": "Commercial capabilities for @docx-editor.dev: the review module (comments, tracked changes, markup rendering) and custom inline nodes over content controls.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "license:check": "license-check-and-add check -f license-check.json",
    "license:add": "license-check-and-add add -f license-check.json"
  },
  "dependencies": {
    "@docx-editor.dev/core-contract": "workspace:*",
    "@docx-editor.dev/i18n": "workspace:*"
  },
  "peerDependencies": {
    "@docx-editor.dev/react": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@docx-editor.dev/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docx-editor.dev/react": "workspace:*",
    "@happy-dom/global-registrator": "^20.8.3",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "fflate": "^0.8.2",
    "license-check-and-add": "^4.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "docx",
    "tracked-changes",
    "comments",
    "content-controls"
  ],
  "author": {
    "name": "EigenPal, Inc.",
    "email": "licensing@eigenpal.com",
    "url": "https://eigenpal.com"
  },
  "license": "LicenseRef-EigenPal-Pro-Evaluation-1.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/pro"
  }
}
