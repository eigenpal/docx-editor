{
  "compilerOptions": {
    // ES2022 rather than ES2020 because this program contains core's sources through the
    // `paths` below, and they use ES2022 features (`Array.prototype.at`, `Error.cause`).
    // An ES2020 floor only appears to work: `@types/bun` pulls in `@types/node`, whose
    // `compatibility/indexable.d.ts` back-declares `.at` for older libs, so the gap hides
    // until something type-checks without those ambient types — such as the dts build.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      // core's and react's export maps point at dist, which typecheck never builds.
      // Map every subpath this package reaches for to source, or the same type arrives
      // under two identities depending on whether a build happens to be lying around.
      "@docx-editor.dev/core": ["../core/src/index.ts"],
      "@docx-editor.dev/core/automation": ["../core/src/automation/index.ts"],
      "@docx-editor.dev/core/binding": ["../core/src/binding/index.ts"],
      "@docx-editor.dev/core/contracts/editor": ["../core/src/contracts/editor.ts"],
      "@docx-editor.dev/core/contracts/document": ["../core/src/contracts/document.ts"],
      "@docx-editor.dev/core/contracts/interaction": ["../core/src/contracts/interaction.ts"],
      "@docx-editor.dev/core/contracts/mcp": ["../core/src/contracts/mcp.ts"],
      "@docx-editor.dev/core/contracts/modules": ["../core/src/contracts/modules.ts"],
      "@docx-editor.dev/core/contracts/plugin": ["../core/src/contracts/plugin.ts"],
      "@docx-editor.dev/core/contracts/types": ["../core/src/contracts/types-barrel.ts"],
      "@docx-editor.dev/core/layout": ["../core/src/layout/index.ts"],
      "@docx-editor.dev/core/output": ["../core/src/output/index.ts"],
      "@docx-editor.dev/core/store": ["../core/src/store/index.ts"],
      "@docx-editor.dev/core/editor": ["../core/src/editor/index.ts"],
      "@docx-editor.dev/core/collaboration": ["../core/src/collaboration/index.ts"],
      "@docx-editor.dev/editor-api": ["../editor-api/src/index.ts"],
      "@docx-editor.dev/react": ["../react/src/index.ts"],
      "@docx-editor.dev/vue": ["../vue/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/vue",
    "src/__tests__/custom-node-vue-chrome.test.ts",
    "src/__tests__/review-sidebar-vue.test.ts",
    "src/__tests__/review-vue-harness.ts",
    "src/__tests__/use-webrtc-collaboration-vue.test.ts"
  ]
}
