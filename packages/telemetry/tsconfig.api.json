{
  // API Extractor's view of this package: core and pro resolve to their built declarations.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@docx-editor.dev/core": ["../core/dist/index.d.ts"],
      "@docx-editor.dev/core/contracts/types": ["../core/dist/contracts/types.d.ts"],
      "@docx-editor.dev/core/contracts/*": ["../core/dist/contracts/*.d.ts"],
      "@docx-editor.dev/core/*": ["../core/dist/*.d.ts"],
      "@docx-editor.dev/pro/collaboration": ["../pro/dist/collaboration/index.d.ts"]
    }
  }
}
