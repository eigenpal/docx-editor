{
  "name": "@docx-editor.dev/collaboration-yjs",
  "version": "2.8.0",
  "description": "Experimental provider-neutral Yjs collaboration for docx-editor.dev",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webrtc": {
      "types": "./dist/webrtc.d.ts",
      "import": "./dist/webrtc.js",
      "require": "./dist/webrtc.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/collaboration-yjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@docx-editor.dev/core": "^2.8.0",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.32"
  },
  "peerDependenciesMeta": {
    "y-webrtc": {
      "optional": true
    }
  },
  "dependencies": {
    "y-protocols": "^1.0.7"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "workspace:*",
    "@happy-dom/global-registrator": "20.9.0",
    "@types/bun": "^1.3.14",
    "fflate": "^0.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.32"
  }
}
