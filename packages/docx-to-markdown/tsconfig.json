{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@docx-editor.dev/core": ["../core/src/index.ts"],
      "@docx-editor.dev/core/export": ["../core/src/export/index.ts"],
      "@docx-editor.dev/core/editor": ["../core/src/editor/index.ts"],
      "@docx-editor.dev/core/layout": ["../core/src/layout/index.ts"],
      "@docx-editor.dev/core/store": ["../core/src/store/index.ts"],
      "@docx-editor.dev/fonts": ["../fonts/src/index.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
