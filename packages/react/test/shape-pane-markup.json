{
  "none": "<div class=\"docx-editor docx-chart-pane docx-shape-pane\"><div class=\"docx-chart-pane__empty\"><p class=\"docx-chart-pane__empty-title\">No shape selected</p><p class=\"docx-chart-pane__empty-body\">Select a shape, text box, or line in the document to format it.</p></div></div>",
