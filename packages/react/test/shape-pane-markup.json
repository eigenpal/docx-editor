{
  "none": "<div class=\"docx-chart-pane docx-shape-pane\"><div class=\"docx-chart-pane__empty\"><p class=\"docx-chart-pane__empty-title\">No shape selected</p><p class=\"docx-chart-pane__empty-body\">Select a shape, text box, or line in the document to format it.</p></div></div>",
  "solid": "<div class=\"docx-chart-pane docx-shape-pane\"><p class=\"docx-chart-pane__alert\" role=\"alert\"></p><p class=\"docx-chart-pane__note\" hidden>Type #RRGGBB or a color name, then press Enter.</p><section class=\"docx-chart-pane__section\"><h3 class=\"docx-chart-pane__title\">Fill</h3><div class=\"docx-chart-pane__color docx-shape-pane__color\"><span class=\"docx-chart-pane__label\">Fill color</span><button type=\"button\" class=\"docx-shape-pane__color-button\" aria-haspopup=\"true\" aria-expanded=\"false\" data-color=\"#4472C4\"><span class=\"docx-shape-pane__chip\" data-none=\"false\" style=\"background: #4472C4;\" aria-hidden=\"true\"></span><span class=\"docx-shape-pane__summary\">Accent 1</span></button></div><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Fill hex color</span><input class=\"docx-dialog__input\" aria-label=\"Fill hex color\" aria-invalid=\"false\" data-draft=\"false\"></label><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Transparency (%)</span><input class=\"docx-dialog__input\" aria-label=\"Transparency (%)\" inputmode=\"decimal\" aria-invalid=\"false\" data-draft=\"false\"></label></section><section class=\"docx-chart-pane__section\"><h3 class=\"docx-chart-pane__title\">Outline</h3><div class=\"docx-chart-pane__color docx-shape-pane__color\"><span class=\"docx-chart-pane__label\">Outline color</span><button type=\"button\" class=\"docx-shape-pane__color-button\" aria-haspopup=\"true\" aria-expanded=\"false\" data-color=\"#000000\"><span class=\"docx-shape-pane__chip\" data-none=\"false\" style=\"background: #000000;\" aria-hidden=\"true\"></span><span class=\"docx-shape-pane__summary\">Text 1</span></button></div><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Outline hex color</span><input class=\"docx-dialog__input\" aria-label=\"Outline hex color\" aria-invalid=\"false\" data-draft=\"false\"></label><div class=\"docx-chart-pane__pair\"><div class=\"docx-chart-pane__field\"><label class=\"docx-chart-pane__label\">Width preset</label><select class=\"docx-dialog__select\"><option>0.25 pt</option><option>0.5 pt</option><option>0.75 pt</option><option>1 pt</option><option>1.5 pt</option><option>2.25 pt</option><option>3 pt</option><option>4.5 pt</option><option>6 pt</option></select></div><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Width (pt)</span><input class=\"docx-dialog__input\" aria-label=\"Width (pt)\" inputmode=\"decimal\" aria-invalid=\"false\" data-draft=\"false\"></label></div></section></div>",
  "gradient": "<div class=\"docx-chart-pane docx-shape-pane\"><p class=\"docx-chart-pane__alert\" role=\"alert\"></p><p class=\"docx-chart-pane__note\" hidden>Type #RRGGBB or a color name, then press Enter.</p><section class=\"docx-chart-pane__section\"><h3 class=\"docx-chart-pane__title\">Fill</h3><p class=\"docx-chart-pane__note\" data-fill-type=\"gradient\">Fill type: Gradient. Pick a color or No fill to replace it.</p><div class=\"docx-chart-pane__color docx-shape-pane__color\"><span class=\"docx-chart-pane__label\">Fill color</span><button type=\"button\" class=\"docx-shape-pane__color-button\" aria-haspopup=\"true\" aria-expanded=\"false\" data-color=\"\"><span class=\"docx-shape-pane__chip\" data-none=\"true\" aria-hidden=\"true\"></span><span class=\"docx-shape-pane__summary\">Gradient</span></button></div><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Fill hex color</span><input class=\"docx-dialog__input\" aria-label=\"Fill hex color\" aria-invalid=\"false\" data-draft=\"false\"></label><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Transparency (%)</span><input class=\"docx-dialog__input\" aria-label=\"Transparency (%)\" inputmode=\"decimal\" aria-invalid=\"false\" disabled=\"\" data-draft=\"false\"></label><p class=\"docx-chart-pane__note\">The shape has no solid fill. Pick a fill color first.</p></section><section class=\"docx-chart-pane__section\"><h3 class=\"docx-chart-pane__title\">Outline</h3><div class=\"docx-chart-pane__color docx-shape-pane__color\"><span class=\"docx-chart-pane__label\">Outline color</span><button type=\"button\" class=\"docx-shape-pane__color-button\" aria-haspopup=\"true\" aria-expanded=\"false\" data-color=\"#000000\"><span class=\"docx-shape-pane__chip\" data-none=\"false\" style=\"background: #000000;\" aria-hidden=\"true\"></span><span class=\"docx-shape-pane__summary\">Text 1</span></button></div><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Outline hex color</span><input class=\"docx-dialog__input\" aria-label=\"Outline hex color\" aria-invalid=\"false\" data-draft=\"false\"></label><div class=\"docx-chart-pane__pair\"><div class=\"docx-chart-pane__field\"><label class=\"docx-chart-pane__label\">Width preset</label><select class=\"docx-dialog__select\"><option>0.25 pt</option><option>0.5 pt</option><option>0.75 pt</option><option>1 pt</option><option>1.5 pt</option><option>2.25 pt</option><option>3 pt</option><option>4.5 pt</option><option>6 pt</option></select></div><label class=\"docx-chart-pane__field\"><span class=\"docx-chart-pane__label\">Width (pt)</span><input class=\"docx-dialog__input\" aria-label=\"Width (pt)\" inputmode=\"decimal\" aria-invalid=\"false\" data-draft=\"false\"></label></div></section></div>"
