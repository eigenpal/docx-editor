{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@docx-editor.dev/core": ["../core/src/index.ts"],
      "@docx-editor.dev/core/editor": ["../core/src/editor.ts"],
      "@docx-editor.dev/core/geometry": ["../core/src/geometry.ts"],
      "@docx-editor.dev/core/types": ["../core/src/types-barrel.ts"],
      "@docx-editor.dev/core/plugin": ["../core/src/plugin.ts"],
      "@docx-editor.dev/core/mcp": ["../core/src/mcp.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
