{
  "name": "@docx-editor.dev/react",
  "version": "0.0.1",
  "description": "React DOCX editor adapter for the @docx-editor.dev editor contract.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/rollup-package-dts.mjs --package @docx-editor.dev/react && node ../../scripts/inject-package-doc.mjs --package @docx-editor.dev/react",
    "typecheck": "tsc --noEmit",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/react --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/react"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docx-editor.dev/core-contract": "workspace:*",
    "fflate": "^0.8.2"
  },
  "keywords": [
    "docx",
    "editor",
    "word",
    "document",
    "react"
  ],
  "author": {
    "name": "Jedr Blaszyk",
    "email": "jedr@eigenpal.com",
    "url": "https://github.com/jedrazb"
  },
  "license": "Apache-2.0",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@docx-editor.dev/agents": "^0.0.1",
    "@docx-editor.dev/i18n": "^0.0.1",
    "@radix-ui/react-select": "^2.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "harfbuzzjs": "1.4.0"
  }
}
