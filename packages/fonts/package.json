{
  "name": "@docx-editor.dev/fonts",
  "version": "0.0.1",
  "description": "Metric-compatible open-licensed substitutes for Word default fonts (Carlito, Caladea, Liberation), packaged for @docx-editor.dev shaped measurement.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./google": {
      "import": {
        "types": "./dist/google.d.ts",
        "default": "./dist/google.js"
      },
      "require": {
        "types": "./dist/google.d.cts",
        "default": "./dist/google.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "licenses",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check",
    "google:catalog": "node scripts/generate-google-catalog.mjs",
    "google:check": "node scripts/generate-google-catalog.mjs --check",
    "google:verify": "node scripts/generate-google-catalog.mjs --verify"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "workspace:*",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "docx",
    "fonts",
    "carlito",
    "caladea",
    "liberation",
    "metric-compatible"
  ],
  "author": {
    "name": "Jedr Blaszyk",
    "email": "jedr@eigenpal.com",
    "url": "https://github.com/jedrazb"
  },
  "license": "Apache-2.0 AND OFL-1.1",
  "homepage": "https://docx-editor.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/fonts"
  }
}
