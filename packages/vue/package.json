{
  "name": "@docx-editor.dev/vue",
  "version": "0.0.1",
  "author": {
    "name": "Jedr Blaszyk",
    "email": "jedr@eigenpal.com",
    "url": "https://github.com/jedrazb"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/docx-editor.git",
    "directory": "packages/vue"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "devDependencies": {
    "@docx-editor.dev/core-contract": "workspace:*",
    "fflate": "^0.8.2",
    "vite-plugin-dts": "^5.0.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "description": "Vue 3 DOCX editor adapter for the @docx-editor.dev editor contract.",
  "files": [
    "dist"
  ],
  "homepage": "https://docx-editor.dev/",
  "keywords": [
    "docx",
    "editor",
    "vue",
    "word",
    "document"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/rollup-package-dts.mjs --package @docx-editor.dev/vue && node ../../scripts/inject-package-doc.mjs --package @docx-editor.dev/vue",
    "typecheck": "tsc --noEmit",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/vue --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @docx-editor.dev/vue"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@docx-editor.dev/i18n": "^0.0.1",
    "emf-converter": "2.0.2",
    "harfbuzzjs": "1.4.0"
  }
}
