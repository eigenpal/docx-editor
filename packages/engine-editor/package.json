{
  "name": "@docx-editor.dev/engine-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser editor composition root: the production createEditor. Composes the PM-free engine-binding edit surface, engine-layout pagination, and engine-output display into the PM-free Editor/EditorHost contract. Becomes @docx-editor.dev/core/editor at the section 7/14 migration.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev:a11y-harness": "vite",
    "test:a11y-harness-vite-exports": "bun scripts/verify-a11y-harness-vite-exports.mjs",
    "test:e2e:a11y-tree": "playwright test e2e/accessibility-tree.pwtest.ts --config playwright.config.ts --timeout=30000 --workers=1",
    "test:lighthouse:a11y-harness": "node scripts/run-lighthouse-a11y-harness.mjs",
    "verify:a11y-tree": "bun run test:e2e:a11y-tree && bun run test:lighthouse:a11y-harness"
  },
  "dependencies": {
    "@docx-editor.dev/core-contract": "workspace:*",
    "@docx-editor.dev/engine-core": "workspace:*",
    "@docx-editor.dev/engine-binding": "workspace:*",
    "@docx-editor.dev/engine-layout": "workspace:*",
    "@docx-editor.dev/engine-output": "workspace:*"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.3",
    "@playwright/test": "^1.60.0",
    "fflate": "^0.8.2",
    "typescript": "^5.3.3",
    "vite": "^8.0.10"
  },
  "license": "Apache-2.0"
}
