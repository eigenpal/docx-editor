{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docx-editor.dev/spike/docx-editor-vocabulary/1.0.0",
  "title": "DocxEditor spike command and query vocabulary",
  "description": "JSON-schema-backed DocxEditor.* vocabulary for engine-neutral EditorDriver lifecycle. No alternate namespace.",
  "version": "1.0.0",
  "namespace": "DocxEditor",
  "$defs": {
    "DocxEditor.Command": {
      "oneOf": [{ "$ref": "#/$defs/toggleMarkCommand" }]
    },
    "DocxEditor.Query": {
      "oneOf": [
        { "$ref": "#/$defs/findTextQuery" },
        { "$ref": "#/$defs/selectedTextQuery" },
        { "$ref": "#/$defs/selectionFormattingQuery" },
        { "$ref": "#/$defs/selectionQuery" }
      ]
    },
    "DocxEditor.CommandResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["applied", "noOp", "failed"] },
        "changed": { "type": "boolean" },
        "code": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DocxEditor.QueryResult": {
      "oneOf": [
        { "$ref": "#/$defs/findTextQueryResult" },
        { "$ref": "#/$defs/selectedTextQueryResult" },
        { "$ref": "#/$defs/selectionFormattingQueryResult" },
        { "$ref": "#/$defs/selectionQueryResult" }
      ]
    },
    "DocxEditor.RunFormatting": {
      "type": "object",
      "properties": {
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "DocxEditor.DocRange": {
      "type": "object",
      "required": ["storyId", "blockId", "start", "end"],
      "properties": {
        "storyId": { "type": "string", "minLength": 1 },
        "blockId": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "toggleMarkCommand": {
      "type": "object",
      "required": ["type", "mark"],
      "properties": {
        "type": { "const": "toggleMark" },
        "mark": { "type": "string", "enum": ["bold", "italic"] },
        "scope": { "$ref": "#/$defs/bodyScope" }
      },
      "additionalProperties": false
    },
    "findTextQuery": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "findText" },
        "text": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/bodyScope" }
      },
      "additionalProperties": false
    },
    "selectedTextQuery": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "selectedText" },
        "scope": { "$ref": "#/$defs/bodyScope" }
      },
      "additionalProperties": false
    },
    "selectionFormattingQuery": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "selectionFormatting" },
        "scope": { "$ref": "#/$defs/bodyScope" }
      },
      "additionalProperties": false
    },
    "selectionQuery": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "selection" },
        "scope": { "$ref": "#/$defs/bodyScope" }
      },
      "additionalProperties": false
    },
    "findTextQueryResult": {
      "type": "object",
      "required": ["type", "ranges"],
      "properties": {
        "type": { "const": "findText" },
        "ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/DocxEditor.DocRange" }
        }
      },
      "additionalProperties": false
    },
    "selectedTextQueryResult": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "selectedText" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "selectionFormattingQueryResult": {
      "type": "object",
      "required": ["type", "formatting"],
      "properties": {
        "type": { "const": "selectionFormatting" },
        "formatting": {
          "oneOf": [{ "$ref": "#/$defs/DocxEditor.RunFormatting" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "selectionQueryResult": {
      "type": "object",
      "required": ["type", "range"],
      "properties": {
        "type": { "const": "selection" },
        "range": {
          "oneOf": [{ "$ref": "#/$defs/DocxEditor.DocRange" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "bodyScope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "body" }
      },
      "additionalProperties": false
    }
  },
  "crossAdapterLifecycleScenario": {
    "id": "lifecycle-bold-roundtrip-v1",
    "adapters": ["react", "vue"],
    "steps": [
      { "action": "loadDocx", "input": "empty-docx-template" },
      { "action": "type", "text": "contract text" },
      { "action": "query", "query": { "type": "findText", "text": "contract" } },
      { "action": "selectText", "text": "contract" },
      { "action": "query", "query": { "type": "selectedText" }, "expect": { "text": "contract" } },
      { "action": "execute", "command": { "type": "toggleMark", "mark": "bold" } },
      {
        "action": "query",
        "query": { "type": "selectionFormatting" },
        "expect": { "formatting": { "bold": true } }
      },
      { "action": "save" },
      { "action": "loadDocx", "input": "saved-bytes" },
      { "action": "selectText", "text": "contract" },
      { "action": "query", "query": { "type": "selectedText" }, "expect": { "text": "contract" } },
      {
        "action": "query",
        "query": { "type": "selectionFormatting" },
        "expect": { "formatting": { "bold": true } }
      }
    ]
  },
  "forbiddenAliases": []
}
