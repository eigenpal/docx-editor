{
  // Declaration-only emit for the docs pipeline. API Extractor cannot read a `.ts`
  // entry point, and these packages ship TypeScript source rather than a bundled
  // `dist`, so `bun run build:types` produces the `.d.ts` tree it reads instead.
  // Output is gitignored and regenerated; nothing consumes it at runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist-types",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true
  },
  "exclude": ["node_modules", "dist", "dist-types", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
